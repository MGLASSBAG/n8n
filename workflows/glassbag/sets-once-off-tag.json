    {
      "parameters": {
        "jsCode": "// Extract Customer Data for Email Marketing Database - UPDATED STRUCTURE\n\nconst orderData = $input.first().json;\n\n// Helper function to normalize postal codes\nfunction normalizeAreaCode(zip, city) {\n  if (!zip && !city) return \"\";\n  \n  let code = (zip || city || \"\").trim().toUpperCase();\n  code = code.replace(/[\\s\\-\\.]/g, '');\n  \n  if (city && city.trim().toUpperCase().includes(\"WICKLOW\")) {\n    return \"WICKLOW\";\n  }\n  \n  if (code.startsWith('D') || code.startsWith('DUBLIN')) {\n    if (code.startsWith('DUBLIN')) {\n      code = code.replace('DUBLIN', 'D');\n    }\n    \n    if (code.length >= 3) {\n      const areaPart = code.substring(0, 3);\n      \n      if (areaPart === 'D6W') {\n        return 'D6W';\n      }\n      \n      const match = areaPart.match(/^D(\\d{1,2})/);\n      if (match) {\n        const num = match[1];\n        if (num.length === 1) {\n          return 'D0' + num;\n        }\n        return 'D' + num;\n      }\n    }\n  }\n  \n  if ((code.startsWith('A') || code.startsWith('K')) && code.length >= 3) {\n    const areaPart = code.substring(0, 3);\n    if (areaPart.match(/^[AK]\\d{2}$/)) {\n      return areaPart;\n    }\n  }\n  \n  return \"\";\n}\n\n// Area-to-schedule mapping\nconst areaSchedule = {\n  \"A94\": { week: 1, weekday: 2, text: \"First Tuesday\" }, \n  \"A96\": { week: 1, weekday: 2, text: \"First Tuesday\" },\n  \"D08\": { week: 1, weekday: 3, text: \"First Wednesday\" }, \n  \"D10\": { week: 1, weekday: 3, text: \"First Wednesday\" }, \n  \"D20\": { week: 1, weekday: 3, text: \"First Wednesday\" },\n  \"D05\": { week: 1, weekday: 4, text: \"First Thursday\" }, \n  \"D09\": { week: 1, weekday: 4, text: \"First Thursday\" }, \n  \"D13\": { week: 1, weekday: 4, text: \"First Thursday\" }, \n  \"D17\": { week: 1, weekday: 4, text: \"First Thursday\" },\n  \"D18\": { week: 2, weekday: 2, text: \"Second Tuesday\" },\n  \"D22\": { week: 2, weekday: 3, text: \"Second Wednesday\" }, \n  \"D24\": { week: 2, weekday: 3, text: \"Second Wednesday\" }, \n  \"K78\": { week: 2, weekday: 3, text: \"Second Wednesday\" },\n  \"D06\": { week: 2, weekday: 4, text: \"Second Thursday\" },\n  \"D16\": { week: 3, weekday: 2, text: \"Third Tuesday\" }, \n  \"WICKLOW\": { week: 3, weekday: 2, text: \"Third Tuesday\" },\n  \"D04\": { week: 3, weekday: 3, text: \"Third Wednesday\" },\n  \"D03\": { week: 3, weekday: 4, text: \"Third Thursday\" }, \n  \"D07\": { week: 3, weekday: 4, text: \"Third Thursday\" },\n  \"D14\": { week: 4, weekday: 2, text: \"Fourth Tuesday\" }, \n  \"D6W\": { week: 4, weekday: 2, text: \"Fourth Tuesday\" },\n  \"D02\": { week: 4, weekday: 3, text: \"Fourth Wednesday\" }, \n  \"D12\": { week: 4, weekday: 3, text: \"Fourth Wednesday\" },\n  \"A41\": { week: 4, weekday: 4, text: \"Fourth Thursday\" }, \n  \"A42\": { week: 4, weekday: 4, text: \"Fourth Thursday\" }, \n  \"A45\": { week: 4, weekday: 4, text: \"Fourth Thursday\" },\n  \"K32\": { week: 4, weekday: 4, text: \"Fourth Thursday\" }, \n  \"K33\": { week: 4, weekday: 4, text: \"Fourth Thursday\" }, \n  \"K34\": { week: 4, weekday: 4, text: \"Fourth Thursday\" },\n  \"K36\": { week: 4, weekday: 4, text: \"Fourth Thursday\" }, \n  \"K45\": { week: 4, weekday: 4, text: \"Fourth Thursday\" }, \n  \"K56\": { week: 4, weekday: 4, text: \"Fourth Thursday\" }, \n  \"K67\": { week: 4, weekday: 4, text: \"Fourth Thursday\" },\n  \"D01\": { week: 4, weekday: 5, text: \"Fourth Friday\" }, \n  \"D11\": { week: 4, weekday: 5, text: \"Fourth Friday\" }, \n  \"D15\": { week: 4, weekday: 5, text: \"Fourth Friday\" }\n};\n\nfunction getProvinceOverride(province, city, areaCode) {\n  province = (province || \"\").trim().toUpperCase();\n  city = (city || \"\").trim().toUpperCase();\n  if (province === \"MEATH\" || province === \"KILDARE\") {\n    return { week: 3, weekday: 5, text: \"Third Friday\" };\n  }\n  if (province === \"WICKLOW\" || city.includes(\"WICKLOW\") || areaCode === \"WICKLOW\") {\n    return { week: 3, weekday: 2, text: \"Third Tuesday\" };\n  }\n  return null;\n}\n\n// Extract customer information\nconst email = orderData.customer?.email || orderData.email || '';\nconst firstName = orderData.customer?.first_name || orderData.shipping_address?.first_name || '';\nconst lastName = orderData.customer?.last_name || orderData.shipping_address?.last_name || '';\nconst phone = orderData.customer?.phone || orderData.shipping_address?.phone || '';\n\n// Build full address\nconst address1 = orderData.shipping_address?.address1 || orderData.billing_address?.address1 || '';\nconst address2 = orderData.shipping_address?.address2 || orderData.billing_address?.address2 || '';\nconst city = orderData.shipping_address?.city || orderData.billing_address?.city || '';\nconst province = orderData.shipping_address?.province || orderData.billing_address?.province || '';\nconst zip = orderData.shipping_address?.zip || orderData.billing_address?.zip || '';\nconst country = orderData.shipping_address?.country || orderData.billing_address?.country || 'Ireland';\n\nlet fullAddress = address1;\nif (address2) fullAddress += `, ${address2}`;\nif (city) fullAddress += `, ${city}`;\nif (province) fullAddress += `, ${province}`;\nif (zip) fullAddress += `, ${zip}`;\nif (country && country !== 'Ireland') fullAddress += `, ${country}`;\n\n// Normalize eircode and determine collection schedule\nconst eircode = normalizeAreaCode(zip, city);\nlet schedule = getProvinceOverride(province, city, eircode);\nif (!schedule) {\n  schedule = areaSchedule[eircode] || { week: null, weekday: null, text: \"Unknown\" };\n}\n\n// Calculate next email date (2 months from today)\nconst today = new Date();\nconst nextEmailDate = new Date(today);\nnextEmailDate.setMonth(today.getMonth() + 2);\n\nconst formatDate = (date) => {\n  return date.toISOString().split('T')[0];\n};\n\n// UPDATED: Match new clean structure\nconst customerData = {\n  \"Email\": email,\n  \"First Name\": firstName,\n  \"Last Name\": lastName,\n  \"Full Address\": fullAddress,\n  \"Eircode\": eircode,\n  \"Phone\": phone,\n  \"Last Collection Date\": formatDate(today),\n  \"Last Order Date\": formatDate(new Date(orderData.created_at)),\n  \"Email Status\": \"Active\",\n  \"Last Email Sent Date\": \"\",\n  \"Email Count\": 0,\n  \"Next Email Due Date\": formatDate(nextEmailDate),\n  \"Collection Week\": schedule.week,\n  \"Collection Day\": schedule.text ? schedule.text.split(' ')[1] : '',\n  \"Collection Schedule Text\": schedule.text,\n  \"Notes\": `Order ID: ${orderData.id}`,\n  \"Source\": \"Auto-Once-Off\",\n  \"Date Added\": formatDate(today)\n};\n\nconsole.log(`Processing once-off customer: ${email} - ${schedule.text}`);\n\nreturn [{ json: customerData }];"
      },
