    {
      "parameters": {
        "jsCode": "// Access new customer data from the \"Edit Fields\" node\nconst newCustomer = $('Edit Fields').first().json;\n\n// Access existing customers data from current input (Fetch Existing Customers)\nconst existingCustomersInput = $input.first().json;\n\n// Handle existing customers data\nlet existingCustomers = [];\nif (Array.isArray(existingCustomersInput)) {\n  existingCustomers = existingCustomersInput;\n} else if (existingCustomersInput) {\n  existingCustomers = [existingCustomersInput];\n}\n\nconsole.log(`Checking new customer against ${existingCustomers.length} existing customers`);\n\n// Create a Set of existing emails for fast lookup (case-insensitive)\nconst existingEmails = new Set();\nexistingCustomers.forEach(customer => {\n  if (customer && customer.Email) {\n    existingEmails.add(customer.Email.toLowerCase().trim());\n  }\n});\n\n// Check if new customer email already exists\nconst newEmail = (newCustomer.Email || '').toLowerCase().trim();\n\nif (!newEmail) {\n  console.log('No email found in new customer data - skipping');\n  return [];\n}\n\nif (existingEmails.has(newEmail)) {\n  console.log(`Customer ${newEmail} already exists in database - skipping`);\n  return [];\n} else {\n  console.log(`New customer ${newEmail} - adding to database`);\n  return [{ json: newCustomer }];\n}"
      },
