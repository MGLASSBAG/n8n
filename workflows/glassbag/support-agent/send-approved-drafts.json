    {
      "parameters": {
        "jsCode": "// Get the original data from Read node (has all customer/classification fields)\nconst originalData = $('Read Approved Drafts').first().json;\n\n// Return original data so external action logging can use it\nreturn [{\n  json: {\n    ...originalData,\n    // Override with confirmed sent status\n    processed: true,\n    sent_timestamp: new Date().toISOString(),\n    approved_at: new Date().toISOString(),\n    draft_status: 'manually_approved_sent',\n    needs_admin: false\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1040,
        640
      ],
      "id": "945c83af-9c9f-4d38-85a8-5966d6cf75af",
      "name": "Restore Data After Update"
    },
