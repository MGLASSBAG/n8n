    {
      "parameters": {
        "jsCode": "const r = $json;\n\n// Build a canonical address from whatever we have\nconst canonicalAddress =\n  r.address_full ||\n  r.address ||\n  [r.address_1, r.address_2, r.city].filter(Boolean).join(', ') ||\n  '';\n\n// Build rich notes with as much customer context as possible\nconst details = [];\n\nif (r.customer_source) details.push(`Source: ${r.customer_source}`);\nif (r.subscription_status) details.push(`Subscription: ${r.subscription_status}`);\nif (r.eircode) details.push(`Eircode: ${r.eircode}`);\nif (canonicalAddress) details.push(`Address: ${canonicalAddress}`);\nif (r.collection_date) details.push(`Next pickup: ${r.collection_date}`);\nif (r.next_collection_day) details.push(`Collection day: ${r.next_collection_day}`);\nif (r.collection_week) details.push(`Collection week: ${r.collection_week}`);\n\nif (r.category) details.push(`Category: ${r.category}`);\nif (r.subcategory) details.push(`Subcategory: ${r.subcategory}`);\nif (r.action_type) details.push(`Action type: ${r.action_type}`);\nif (r.summary) details.push(`Summary: ${r.summary}`);\nif (r.customer_intent) details.push(`Intent: ${r.customer_intent}`);\n\nif (r.requires_verification) {\n  details.push(\n    `Requires verification: ${r.requires_verification} ${\n      r.verification_reason ? `(${r.verification_reason})` : ''\n    }`.trim()\n  );\n}\n\nif (r.needs_admin) details.push(`Needs admin: ${r.needs_admin}`);\nif (r.admin_notes) details.push(`Admin notes: ${r.admin_notes}`);\n\n// Build the row exactly matching the Pending Actions sheet columns\nconst row = {\n  // Sheets column: \"created_at\"\n  // (we keep the capital-C key because your Append node reads `$json.Created_at`)\n  Created_at: r.sent_timestamp || r.timestamp || new Date().toISOString(),\n\n  // Sheets column: \"source_message_id\"\n  source_message_id: r.message_id || '',\n\n  // Sheets column: \"action_type\"\n  action_type: r.action_type || 'none',\n\n  // Sheets column: \"status\"\n  status: 'open',\n\n  // Sheets column: \"assignee\"\n  assignee: '',\n\n  // Sheets column: \"customer_name\"\n  customer_name: r.name || r.customer_name || '',\n\n  // Sheets column: \"email\"\n  email: r.email_from || r.email || '',\n\n  // Sheets column: \"phone\"\n  phone: r.phone || '',\n\n  // Sheets column: \"address\"\n  address: canonicalAddress,\n\n  // Sheets column: \"province\"\n  province: r.province || '',\n\n  // Sheets column: \"eircode\"\n  eircode: r.eircode || '',\n\n  // Sheets column: \"notes\"\n  notes: details.join(' | '),\n\n  // Sheets column: \"priority\"\n  priority: r.urgency || 'normal',\n\n  // Sheets column: \"completed_at\"\n  completed_at: '',\n};\n\nreturn [{ json: row }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        640
      ],
      "id": "d8ca27ad-e489-4e1f-a080-3a26c6d8edbb",
      "name": "Build Pending Action Row"
