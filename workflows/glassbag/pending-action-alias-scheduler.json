      "parameters": {
        "jsCode": "// === Check if Alias Action ===\n// Input: { task: {...}, api: {...} }\n// Output: { task, api, alias_action }\n\nconst items = $input.all();\nconst out = [];\n\nfor (const item of items) {\n  const j = item.json || {};\n  const task = j.task || null;\n  const api  = j.api || {};\n\n  let alias_action = 'skip';\n\n  // Only create once-off when:\n  // - schedule found\n  // - there is an earlier alias\n  // - best_alias exists\n  // - main route is more than 10 days away\n  if (\n    api.found === true &&\n    api.has_earlier_alias === true &&\n    api.best_alias &&\n    typeof api.days_until_collection === 'number' &&\n    api.days_until_collection > 14\n  ) {\n    alias_action = 'create_onceoff';\n  }\n\n  out.push({\n    json: {\n      task,\n      api,\n      alias_action,\n    },\n  });\n}\n\nreturn out;\n"
      },
