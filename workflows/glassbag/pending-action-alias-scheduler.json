    {
      "parameters": {
        "jsCode": "// === Build Standard Once Off Row (no alias) ===\n// Input: { task: {...}, api: {...} }\n// Output: spreads task, adds onceOffRow built from MAIN schedule (not alias)\n\nconst items = $input.all();\nconst out = [];\n\nconst monthNames = [\n  'January','February','March','April','May','June',\n  'July','August','September','October','November','December'\n];\n\nfunction weekNumberFromLabel(label) {\n  const map = { First: 1, Second: 2, Third: 3, Fourth: 4, Fifth: 5 };\n  const firstWord = String(label || '').split(' ')[0];\n  return map[firstWord] || '';\n}\n\nfor (const item of items) {\n  const j = item.json || {};\n  const task = j.task || {};      // Pending Actions row\n  const api  = j.api  || {};      // collection-date response (MAIN schedule fields)\n\n  // MAIN schedule fields expected from your API:\n  // api.next_collection_date (YYYY-MM-DD), api.collection_week (e.g. \"Fourth Monday\"),\n  // api.collection_day (e.g. \"Monday\"), api.area_code, api.days_until_collection, etc.\n\n  const mainDateIso = api.next_collection_date || null; // \"YYYY-MM-DD\"\n  let monthName = '';\n  let collectionWeekNum = '';\n  let collectionDayLabel = api.collection_week || '';   // \"Fourth Monday\"\n\n  if (mainDateIso) {\n    const d = new Date(mainDateIso + 'T00:00:00Z');\n    if (!isNaN(d.getTime())) {\n      monthName = monthNames[d.getUTCMonth()];\n    }\n    collectionWeekNum = weekNumberFromLabel(collectionDayLabel);\n  }\n\n  // NEW: Format Full Name as \"DELIVER BAG - [[CUSTOMER NAME]]\"\n  const customerName = String(task.customer_name || '').trim() || '';\n  const eircode = String(task.eircode || '').trim() || '';\n  const fullName = customerName\n    ? `DELIVER BAG - ${customerName}`\n    : (eircode ? `DELIVER BAG - ${eircode}` : 'DELIVER BAG - UNKNOWN');\n\n  const onceOffRow = {\n    Email: task.email || '',\n    'Full Name': fullName,\n    'Address 1': task.address || '',\n    City: task.province || '',\n    Province: task.province || '',\n    Zip: task.eircode || '',\n    Country: 'Ireland',\n    Phone: task.phone || '',\n    Notes: 'Standard route (no alias)',\n    Month: monthName || '',\n    'Collection Week': collectionWeekNum,        // 1\u20135\n    'Collection Day': collectionDayLabel || ''   // \"Fourth Monday\"\n  };\n\n  out.push({\n    json: {\n      ...task,\n      api,\n      alias_action: 'standard_onceoff',\n      alias_onceoff_created: false,\n      alias_area_code: 'No Alias',\n      alias_collection_date: 'No Alias',\n      onceOffRow\n    }\n  });\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        128
      ],
