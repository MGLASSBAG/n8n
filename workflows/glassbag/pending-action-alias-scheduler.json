    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\n\nconst monthNames = [\n  'January','February','March','April','May','June',\n  'July','August','September','October','November','December'\n];\n\nfunction weekNumberFromLabel(label) {\n  const map = { First: 1, Second: 2, Third: 3, Fourth: 4, Fifth: 5 };\n  const firstWord = String(label || '').split(' ')[0];\n  return map[firstWord] || '';\n}\n\nfor (const item of items) {\n  const j = item.json || {};\n\n  // task may be nested, api always nested\n  const task = j.task || {};      // Pending Actions row\n  const api  = j.api  || {};      // collection-date response\n  const best = api.best_alias || null;\n\n  if (j.alias_action !== 'create_onceoff' || !best) {\n    // If somehow not eligible, just flatten task minimally\n    out.push({ json: { ...task, api, alias_action: j.alias_action } });\n    continue;\n  }\n\n  // --- 1) Derive Month + Collection Week/Day from alias date ---\n  const aliasDateStr = best.next_collection_date; // \"YYYY-MM-DD\"\n  const d = new Date(aliasDateStr + 'T00:00:00Z');\n\n  const monthName = monthNames[d.getUTCMonth()];\n  const collectionWeekNum = weekNumberFromLabel(best.collection_week);\n  const collectionDayLabel = best.collection_week; // e.g. \"Fourth Monday\"\n\n  // --- 2) Build Full Name label for Once-Off sheet ---\n  const prefix =\n    task.action_type === 'deliver_bag'\n      ? 'DELIVER BAG'\n      : 'MISSED COLLECTION';\n\n  const customerName = task.customer_name || '';   // use customer's name\n  const addressStr = task.address || '';\n\n  // \"DELIVER BAG - Molly Carbery\" / \"MISSED COLLECTION - Molly Carbery\"\n  const fullName = `${prefix} - ${customerName}`.trim();\n\n  // --- 3) Build Once-Off row payload ---\n  const onceOffRow = {\n    Email: task.email || '',\n    'Full Name': fullName,\n    'Address 1': addressStr,\n    City: task.province || '',\n    Province: task.province || '',\n    Zip: task.eircode || '',\n    Country: 'Ireland',\n    Phone: task.phone || '',\n    Notes: `Alias route ${best.area_code} from ${api.area_code}`,\n    Month: monthName,\n    'Collection Week': collectionWeekNum, // \ud83d\udc48 1\u20135, matches sheet column\n    'Collection Day': collectionDayLabel  // \"Fourth Monday\"\n  };\n\n  // --- 4) FLATTEN: spread task at top level, keep api + alias metadata ---\n  out.push({\n    json: {\n      ...task,                        // all the original columns (status, name, etc.)\n      api,                            // keep api nested if you still want it\n      alias_action: j.alias_action,\n      alias_onceoff_created: true,\n      alias_area_code: best.area_code,\n      alias_collection_date: aliasDateStr,\n      onceOffRow\n    }\n  });\n}\n\nreturn out;\n"
      },
